# ══════════════════════════════════════════════════════════════════
# JAYTEL CLASSIC STORE — Environment Variable Template
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to Git.
# ══════════════════════════════════════════════════════════════════

# ── App Settings ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Jaytel Classic Store"
NEXT_PUBLIC_APP_URL="http://localhost:3002"
NEXT_PUBLIC_STORE_CURRENCY="GHS"

# ── Firebase Client SDK (browser-safe) ────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="paste-your-firebase-api-key-here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:paste-your-app-id-here"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Firebase Admin SDK (server-side ONLY — never expose to browser) ─
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="paste-your-private-key-here"

# ── Paystack Payment Gateway ───────────────────────────────────────
# Get your keys from https://dashboard.paystack.com → Settings → API
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="paste-your-paystack-public-key-here"
PAYSTACK_SECRET_KEY="paste-your-paystack-secret-key-here"
PAYSTACK_WEBHOOK_SECRET="paste-your-paystack-webhook-secret-here"

# ── Cloudinary (Product Image Uploads) ────────────────────────────
# Get your credentials from https://cloudinary.com → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="paste-your-cloudinary-api-key-here"
CLOUDINARY_API_SECRET="paste-your-cloudinary-api-secret-here"

# ── Store Contact Defaults ─────────────────────────────────────────
STORE_SUPPORT_PHONE="0244123456"
STORE_SUPPORT_EMAIL="orders@jaytelclassic.com"
STORE_PICKUP_LOCATION="Jaytel Classic Store, East Legon, Accra, Ghana"
